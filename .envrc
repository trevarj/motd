use flake
export ADB_SERVER_SOCKET=tcp:5037
export ANDROID_ADB_SERVER_PORT=5037

export MOTD_KEYSTORE_PATH="$HOME/secrets/motd-release.jks"

# Keep signing credentials outside the repository and shell history.
motd_release_env="$HOME/secrets/motd-release.env"
if [[ -f "$motd_release_env" ]]; then
  source "$motd_release_env"
fi
unset motd_release_env
