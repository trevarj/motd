<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <service
            android:name=".e2e.E2eSidecarProviderService"
            android:exported="true"
            android:label="motd E2E Companion"
            android:process=":sidecarfixture">
            <intent-filter>
                <action android:name="io.github.trevarj.motd.sidecar.PROVIDER" />
            </intent-filter>
            <meta-data android:name="io.github.trevarj.motd.sidecar.API_VERSION" android:value="1" />
        </service>
        <activity
            android:name=".e2e.E2eSidecarPairActivity"
            android:exported="true"
            android:process=":sidecarfixture" />

        <!-- Test-only host for component instrumentation; see ComposeHostActivity. -->
        <activity
            android:name=".ComposeHostActivity"
            android:exported="false"
            android:theme="@style/Theme.Motd"
            android:windowSoftInputMode="adjustResize" />

        <!-- E2E-only unicode text-entry bridge for test/e2e/lib.sh; see E2eClipboardReceiver.
             Exported on purpose: the adb shell uid must reach it, this build type is never
             shipped, and the worst a caller can do is set the emulator clipboard. -->
        <receiver
            android:name=".E2eClipboardReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="io.github.trevarj.motd.e2e.SET_CLIPBOARD" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
